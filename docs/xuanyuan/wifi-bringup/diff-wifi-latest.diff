+			wr(ep_conf + cap + 8, (uint32_t)(pa >> 32));
+			wr(ep_conf + cap + 12, 0);              /* the data */
+			/* the message control is the upper 16 bits of the dword at cap: an aligned
+			 * read-modify-write, because a 32-bit store at cap+2 faults unaligned */
+			wr(ep_conf + cap, (w & 0xffffu) | (((w >> 16) | 1u) << 16));
+			say("msi: capability %#x programmed to %#llx: control %#x\n", cap, pa,
+			    rd(ep_conf + cap) >> 16);
+			return 0;
+		}
+		cap = (w >> 8) & 0xff;
+	}
+	say("msi: no MSI capability found\n");
+	return -1;
+}
