+/*
+ * The endpoint's MSI capability (PCI 0x05): point its message address at a page of the low DMA
+ * window and enable it, so the writes the firmware makes when it raises MHI interrupts land in
+ * that page. Without it the first interrupt of the running firmware is an MSI write to an
+ * unprogrammed address, and the kernel goes down right after the boot loader hands over.
+ */
+/* (the other half of msi_program: silence the endpoint again) */
+static void
+msi_mask(void)
+{
+	uint32_t cap = rd(ep_conf + 0x34) & 0xff;
+
+	for (unsigned guard = 0; cap >= 0x40 && cap + 16 <= 0x1000 && guard < 48; guard++) {
+		uint32_t w = rd(ep_conf + cap);
+
+		if ((w & 0xff) == 0x05) {
+			wr(ep_conf + cap, (w & 0xffffu) | ((w >> 16) & ~1u) << 16);
+			say("msi: capability %#x masked: control %#x\n", cap, rd(ep_conf + cap) >> 16);
+			return;
+		}
+		cap = (w >> 8) & 0xff;
+	}
+}
+
+static int
+msi_program(uint64_t pa)
+{
+	uint32_t cap = rd(ep_conf + 0x34) & 0xff;
+
+	for (unsigned guard = 0; cap >= 0x40 && cap + 16 <= 0x1000 && guard < 48; guard++) {
+		uint32_t w = rd(ep_conf + cap);
+
+		if ((w & 0xff) == 0x05) {
