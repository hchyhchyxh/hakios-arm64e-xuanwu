+      lck_mtx_unlock(&touch_lock);wakeup(&touch_queue);return;
+     }
+    }
 	if (touch_tail - touch_head == TOUCH_QUEUE) {
 		touch_head++;                   /* nobody reads: drop the oldest */
 	}
