#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
if [ "${XNU_ARCH:-arm64}" = arm64e ]; then
 extra+=(-D__PTRAUTH_INTRINSICS__=1 -fptrauth-intrinsics -fptrauth-calls -fptrauth-returns -fptrauth-auth-traps)
fi
args=()
for a in "$@"; do
  case "$a" in
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) ;;
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension|-mno-implicit-sme) ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
exec /usr/bin/$drv-21 -include "$HB/../../hostinc/xnu_clang_compat.h" -target ${XNU_ARCH:-arm64}-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
  -w "${extra[@]}" "${args[@]}"
